[Unit]
Description=MemoryMap
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/MemoryMap
Environment=NODE_ENV=production
Environment=PORT=4172
Environment=HOST=0.0.0.0
Environment=WARM_GLOBAL_GEO_INDEX=0
ExecStart=/root/.nvm/versions/node/v24.16.0/bin/node /opt/MemoryMap/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
